class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int k) {
        sort(nums.begin(),nums.end());
        vector<int>res(2,-1);
        
        for(int i=0;i<nums.size();i++){
            
            if(nums[i]==k){
                if(res[0]==-1){
                res[0]=i;
                }
                    res[1]=i;
                
            }
        }
        return res;

    }
};
