class Solution {
public:
    int findTheWinner(int n, int k) {
        queue<int> q;
        for(int i=1;i<=n;i++){
            q.push(i);
        }
        int ct=1;
        while(q.size()>1){
        if(ct==k){
            q.front();
            q.pop();
            ct=1;
        }else{
            q.push(q.front());
            q.pop();
            ct++;
        }
    }
        return q.front();
    }
};
